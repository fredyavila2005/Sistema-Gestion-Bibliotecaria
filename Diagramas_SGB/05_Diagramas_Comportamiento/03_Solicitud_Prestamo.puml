@startuml 03_Solicitud_Prestamo
title Actividad: solicitud y validación de un préstamo (PrestamoService.prestar)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #44546A
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #F9A825
}
skinparam note {
  BackgroundColor #FFFDE7
}
start
:menu_prestamos: leer documento, ISBN y fecha\n(Enter = fecha de hoy);
if (¿Fecha con formato AAAA-MM-DD?) then (no)
  #FFCDD2:ValueError "Fecha inválida";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
:UsuarioRepository.find_by_documento(documento);
if (¿El usuario existe?) then (no)
  #FFCDD2:ValueError "No existe un usuario con el documento";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
if (¿Estado del usuario es ACTIVO?) then (no)
  #FFCDD2:ValueError "El usuario no está activo";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
if (¿Hay repo_multas configurado y multas pendientes?) then (sí)
  #FFCDD2:ValueError "El usuario tiene multas pendientes";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
:PrestamoRepository.find_by_usuario(documento);
:Contar préstamos ACTIVO o VENCIDO (sin devolver);
if (¿Préstamos sin devolver >= cupo del tipo?\n(estudiante 3, docente 5, externo 2)) then (sí)
  #FFCDD2:ValueError "El usuario alcanzó su cupo";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
:LibroRepository.find_by_isbn(isbn);
if (¿El libro existe?) then (no)
  #FFCDD2:ValueError "No existe un libro con el ISBN";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
if (¿Hay al menos 1 ejemplar disponible?) then (no)
  #FFCDD2:ValueError "No hay ejemplares disponibles";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
if (¿El usuario ya tiene prestado ese libro sin devolver?) then (sí)
  #FFCDD2:ValueError "El usuario ya tiene prestado ese libro";
  :El menú muestra ✘ y vuelve al menú;
  stop
endif
:Fecha límite = fecha del préstamo + días del tipo\n(estudiante 7, docente 15, externo 5);
:Crear Prestamo (código PRE-..., estado ACTIVO);
:PrestamoRepository.guardar(prestamo);
:libro.disponibles = libro.disponibles - 1;
:LibroRepository.actualizar(libro);
:El menú muestra ✔ Préstamo registrado;
stop
@enduml
